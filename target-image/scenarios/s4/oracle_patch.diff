diff --git a/app/Http/Controllers/ReportController.php b/app/Http/Controllers/ReportController.php
--- a/app/Http/Controllers/ReportController.php
+++ b/app/Http/Controllers/ReportController.php
@@ -47,8 +47,11 @@ class ReportController extends Controller
         if (!$row) {
             return response()->json(['error' => 'Report not found'], 404);
         }
-        // MISSING per-object authorization: should verify
-        // $row->owner === $request->user()->username (or an explicit share).
+        // Per-object authorization: only the owner may read the report. Fail closed
+        // (404) for any other caller so ownership cannot be enumerated.
+        if ($row->owner !== $request->user()->username) {
+            return response()->json(['error' => 'Report not found'], 404);
+        }
         return response()->json(['report' => $this->serialize($row)]);
     }
 }
