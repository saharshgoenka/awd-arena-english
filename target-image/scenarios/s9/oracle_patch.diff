+static LOGIN_ATTEMPTS: LazyLock<Mutex<HashMap<String, (u32, Instant)>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+const MAX_ATTEMPTS: u32 = 5;
+const WINDOW_SECS: u64 = 60;
