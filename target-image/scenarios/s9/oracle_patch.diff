+        .map(|a| a.ip().to_string())
+        .unwrap_or_default();
+
+    {
+        let attempts = LOGIN_ATTEMPTS.lock().unwrap();
+        if let Some((count, first)) = attempts.get(&ip) {
+            if first.elapsed().as_secs() < WINDOW_SECS && *count >= MAX_ATTEMPTS {
+                return HttpResponse::TooManyRequests()
+                    .json(json!({ "error": "too many login attempts" }));
+            }
+        }
+    }
+
     let conn = db.lock().unwrap();
