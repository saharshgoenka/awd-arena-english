+    {
+        let mut attempts = LOGIN_ATTEMPTS.lock().unwrap();
+        let entry = attempts.entry(ip).or_insert((0, Instant::now()));
+        if entry.1.elapsed().as_secs() >= WINDOW_SECS {
+            *entry = (0, Instant::now());
+        }
+        entry.0 += 1;
+    }
     HttpResponse::Unauthorized().json(json!({ "error": "invalid credentials" }))
 }
 
