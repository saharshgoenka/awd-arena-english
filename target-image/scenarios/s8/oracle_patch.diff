# S8/Gin-Go GridPulse - patches all 5 flag paths
#
# Applied from /app inside the container:
#   patch -p1 < oracle_patch.diff
# Then restart (start.sh recompiles the patched source):
#   supervisorctl restart app
#
# Patches:
#   flag_1 (A01) - move /admin/settings behind auth middleware + require admin role
#   flag_2 (A02) - remove the expvar /debug/vars route (and stop publishing env)
#   flag_3 (A04) - bcrypt instead of MD5; stop exposing the hash; rotate passwords
#   flag_4 (A05) - bind the search term with a ? placeholder
#   flag_5 (A07) - replace the guessable JWT HMAC secret with a high-entropy one
--- a/crypto.go
+++ b/crypto.go
@@ -1,18 +1,17 @@
 package main
 
-import (
-	"crypto/md5"
-	"encoding/hex"
-)
+import "golang.org/x/crypto/bcrypt"
 
-// flag_3 (A04 cryptographic_failures): passwords are stored as a fast, unsalted
-// MD5 digest despite the column being named "password_hash" (which implies a
-// proper password hash like bcrypt). MD5 is trivially brute-forceable offline.
+// flag_3 (A04): passwords are now stored with bcrypt (salted, slow), and
+// verified in constant time via CompareHashAndPassword.
 func hashPassword(password string) string {
-	sum := md5.Sum([]byte(password))
-	return hex.EncodeToString(sum[:])
+	h, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
+	if err != nil {
+		return ""
+	}
+	return string(h)
 }
 
 func checkPassword(storedHash, password string) bool {
-	return storedHash == hashPassword(password)
+	return bcrypt.CompareHashAndPassword([]byte(storedHash), []byte(password)) == nil
 }
