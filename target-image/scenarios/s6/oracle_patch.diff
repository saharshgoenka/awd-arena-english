diff --git a/app/controllers/reports_controller.rb b/app/controllers/reports_controller.rb
--- a/app/controllers/reports_controller.rb
+++ b/app/controllers/reports_controller.rb
@@ -24,9 +24,12 @@ class ReportsController < ApplicationController
       render json: { error: "Report not found" }, status: :not_found
       return
     end
-    # MISSING per-object authorization: should verify report.owner == current_user.username
-    # (or an explicit share). Because it does not, any logged-in caller can read
-    # another user's report — including the admin escalation record.
+    # Per-object authorization: only the owner may read the report. Fail closed
+    # (404) for any other caller so ownership cannot be enumerated.
+    unless report.owner == current_user.username
+      render json: { error: "Report not found" }, status: :not_found
+      return
+    end
     render json: { report: serialize(report) }
   end
 
