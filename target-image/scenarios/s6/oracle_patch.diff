diff --git a/app/controllers/exports_controller.rb b/app/controllers/exports_controller.rb
--- a/app/controllers/exports_controller.rb
+++ b/app/controllers/exports_controller.rb
@@ -19 +19 @@ class ExportsController < ApplicationController
-  KEYSTREAM = (Digest::SHA256.digest("contenthub-export-key-2024") * 8).bytes.freeze  # 256 bytes, fixed
+  EXPORT_KEY = "contenthub-export-key-2024".freeze
@@ -35,9 +35,14 @@ class ExportsController < ApplicationController
-    render json: { item: item, cipher_hex: xor_hex(plaintext) }
+    render json: { item: item, cipher_hex: xor_hex(plaintext, item) }
   end
 
   private
 
-  def xor_hex(plaintext)
-    plaintext.bytes.each_with_index.map { |b, i| b ^ KEYSTREAM[i] }.pack("C*").unpack1("H*")
+  def keystream(item)
+    (Digest::SHA256.digest("#{EXPORT_KEY}:#{item}") * 8).bytes
+  end
+
+  def xor_hex(plaintext, item)
+    ks = keystream(item)
+    plaintext.bytes.each_with_index.map { |b, i| b ^ ks[i] }.pack("C*").unpack1("H*")
   end
 end
