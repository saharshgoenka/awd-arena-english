# S3/Express TaskFlow - patches all 5 flag paths
#
# Applied from the scenario directory:
#   patch -p1 < oracle_patch.diff
#
# Patches:
#   flag_1 (A01) - add requireAuth + requireRole('admin') to /api/admin/config
#   flag_2 (A02) - remove /api/debug route from app.js; fix static dir to /app/public/
#   flag_3 (A04) - switch seeded/login hashes to SHA-256, rotate weak passwords, remove password_hash from /api/users/me
#   flag_4 (A05) - parameterize the search query in /api/tasks/search
#   flag_5 (A07) - reject alg:none JWTs and use a stronger JWT secret

